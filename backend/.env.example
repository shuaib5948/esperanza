# Esperanza 2026-27 Backend Environment Variables
PORT=5000
NODE_ENV=production

# Database Configuration (MySQL 8)
# If deployed on Railway, Railway will auto-populate MYSQLHOST / DB_HOST
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=esperanza
DB_USER=root
DB_PASSWORD=your_database_password
DB_CONNECTION_LIMIT=10

# Security & JWT Tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Frontend Client URL (For CORS - e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173

# Master Admin Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@esperanza.local
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=Festival Administrator

# Team Leader Diraya
TEAM_A_USERNAME=diraya
TEAM_A_EMAIL=diraya@esperanza.local
TEAM_A_PASSWORD=your_secure_diraya_password
TEAM_A_NAME=House Diraya Leader

# Team Leader Rivaya
TEAM_B_USERNAME=rivaya
TEAM_B_EMAIL=rivaya@esperanza.local
TEAM_B_PASSWORD=your_secure_rivaya_password
TEAM_B_NAME=House Rivaya Leader

# Stage Judge
JUDGE_STAGE_USERNAME=judge1
JUDGE_STAGE_EMAIL=judge1@esperanza.local
JUDGE_STAGE_PASSWORD=your_secure_stage_judge_pass
JUDGE_STAGE_NAME=Stage Judge
JUDGE_STAGE_CODE=STAGE_JUDGE

# Off-Stage Judge
JUDGE_OFFSTAGE_USERNAME=offjudge
JUDGE_OFFSTAGE_EMAIL=offjudge@esperanza.local
JUDGE_OFFSTAGE_PASSWORD=your_secure_offstage_judge_pass
JUDGE_OFFSTAGE_NAME=Off-Stage Judge
JUDGE_OFFSTAGE_CODE=OFFSTAGE_JUDGE
